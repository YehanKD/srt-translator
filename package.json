{
  "name": "srt-translator",
  "version": "2.0.4",
  "description": "AI-powered subtitle translator: any language into natural spoken Sinhala",
  "homepage": "https://github.com/YehanKD/srt-translator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YehanKD/srt-translator.git"
  },
  "bugs": {
    "url": "https://github.com/YehanKD/srt-translator/issues"
  },
  "author": "Yehan <yehan@swict.lk>",
  "license": "MIT",
  "desktopName": "srt-translator.desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "electron-vite build && electron-builder --win --publish never",
    "package:linux": "electron-vite build && electron-builder --linux --publish never",
    "test": "node --test 'tests/**/*.test.mjs'"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true
  }
}
